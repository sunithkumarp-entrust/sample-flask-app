{
  "name": "fetch-secret-js-action",
  "version": "1.0.0",
  "description": "GitHub Action to fetch secrets from a vault",
  "main": "index.js",
  "scripts": {
    "prepare": "npm run build",
    "build": "ncc build index.js -o dist",
    "test": "npx jest --verbose",
    "test:watch": "npx jest --watch",
    "test:coverage": "npx jest --coverage",
    "test:ci": "npx jest --ci --reporters=default --reporters=jest-junit"
  },
  "keywords": [
    "github",
    "actions",
    "vault",
    "secrets"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.10.0",
    "axios": "^1.3.4"
  },
  "devDependencies": {
    "@vercel/ncc": "^0.36.1",
    "jest": "^29.5.0",
    "jest-junit": "^16.0.0"
  },
  "jest": {
    "testEnvironment": "node"
  }
}
